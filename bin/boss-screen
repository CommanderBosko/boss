#!/usr/bin/env bash
# Read-only: the last N lines on a worker's screen (its herdr pane, else its kitty window).
# Usage: boss-screen <name> [lines]
set -u
. "$(dirname "$(readlink -f "$0")")/lib.sh"
pid=$(pid_for "${1:?usage: boss-screen <name> [lines]}") || exit 1
text=$(screen_text "$pid"); rc=$?
[ $rc -eq 2 ] && { echo "$1 has no reachable window (not in herdr, and not in a kitty with remote control)" >&2; exit 1; }
[ $rc -ne 0 ] && { echo "could not read $1's screen" >&2; exit 1; }
printf '%s\n' "$text" | sed 's/[[:space:]]*$//' | grep -v '^$' | tail -n "${2:-40}"
